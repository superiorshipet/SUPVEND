{
  "info": {
    "name": "SUPVEND API",
    "description": "Multi-vendor marketplace API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userData\": {\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\",\n    \"password\": \"123456\"\n  },\n  \"role\": \"customer\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Register Vendor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userData\": {\n    \"name\": \"Vendor Name\",\n    \"email\": \"vendor@example.com\",\n    \"password\": \"123456\"\n  },\n  \"role\": \"vendor\",\n  \"vendorData\": {\n    \"storeName\": \"My Store\",\n    \"storeDescription\": \"Best products ever\",\n    \"contactPhone\": \"+1234567890\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/register",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/login",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/me",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auth/logout",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "📦 Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products?page=1&limit=20&sort=-createdAt",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "sort", "value": "-createdAt" }
              ]
            }
          }
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products/PRODUCT_ID",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "products", "PRODUCT_ID"]
            }
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products?search=iphone&minPrice=100&maxPrice=2000",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "search", "value": "iphone" },
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "2000" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "🛒 Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/cart",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "cart"]
            }
          }
        },
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"PRODUCT_ID\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/cart/add",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "cart", "add"]
            }
          }
        },
        {
          "name": "Apply Coupon",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"couponCode\": \"SUPERIOR004\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/cart/coupon",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "cart", "coupon"]
            }
          }
        },
        {
          "name": "Remove Coupon",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/cart/coupon",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "cart", "coupon"]
            }
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/cart/clear",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "cart", "clear"]
            }
          }
        }
      ]
    },
    {
      "name": "📝 Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"wallet\",\n  \"shippingAddress\": {\n    \"fullName\": \"John Doe\",\n    \"street\": \"123 Main St\",\n    \"city\": \"New York\",\n    \"state\": \"NY\",\n    \"country\": \"USA\",\n    \"zipCode\": \"10001\",\n    \"phone\": \"+1234567890\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/orders",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "orders"]
            }
          }
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/orders/my-orders",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "orders", "my-orders"]
            }
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Changed my mind\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/orders/ORDER_ID/cancel",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "orders", "ORDER_ID", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "💰 Wallet",
      "item": [
        {
          "name": "Get Wallet Balance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/wallet",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "wallet"]
            }
          }
        },
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN}}" }],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/wallet/transactions",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "wallet", "transactions"]
            }
          }
        }
      ]
    },
    {
      "name": "⚡ Flash Sales",
      "item": [
        {
          "name": "Get Active Flash Sales",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/v1/flash-sales/active",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "flash-sales", "active"]
            }
          }
        }
      ]
    },
    {
      "name": "🔨 Auctions",
      "item": [
        {
          "name": "Get Active Auctions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auctions/active",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auctions", "active"]
            }
          }
        },
        {
          "name": "Place Bid",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{TOKEN}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bidAmount\": 100\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/auctions/AUCTION_ID/bid",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "auctions", "AUCTION_ID", "bid"]
            }
          }
        }
      ]
    },
    {
      "name": "🏷️ Categories",
      "item": [
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/v1/categories",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "categories"]
            }
          }
        }
      ]
    },
    {
      "name": "🎫 Coupons",
      "item": [
        {
          "name": "Validate Coupon",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SUPERIOR004\",\n  \"subtotal\": 1000\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/coupons/validate",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "coupons", "validate"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000"
    },
    {
      "key": "TOKEN",
      "value": ""
    }
  ]
}
